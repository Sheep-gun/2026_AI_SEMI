# Keep manifest-bound text byte-stable across Windows and Linux checkouts.
* text=auto eol=lf

# Binary EDA and media artifacts must never receive text conversion.
*.dcp binary
*.wdb binary
*.png binary
*.pdf binary

# CommonMark uses two trailing spaces for an explicit line break.
*.md whitespace=-trailing-space,-blank-at-eof

# Tool-generated evidence contains fixed-width formatting whitespace.
*.rpt -whitespace
*.log -whitespace
*.vcd -whitespace
*.sdf -whitespace
*.v -whitespace

# Preserve existing manifest-bound source/script EOF bytes.
*.sv whitespace=-blank-at-eof
*.ps1 whitespace=-blank-at-eof
*.sh whitespace=-blank-at-eof
